{
    "name": "dsh-agents-in-the-loop",
    "version": "1.5.0",
    "description": "DSH plugin: cross-session call center for agents. session_message delivers messages between DSH sessions (idle: visible full-text wake; busy: mid-turn-safe notice; plus runtime-context notes) and resolves targets by registered contact name (stale-id-proof). contacts is a named directory over session ids. v1.5.0 adds a send-only loopback HTTP API so external agents (Claude Code etc.) can message registered contacts.",
    "type": "module",
    "main": "lib/index.js",
    "exports": {
        ".": "./lib/index.js",
        "./package.json": "./package.json"
    },
    "files": [
        "lib/**/*.js",
        "cordis.patch.yml",
        "SKILL.md",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "license": "MIT",
    "dependencies": {},
    "repository": {
        "type": "git",
        "url": "https://github.com/markelayan/agents-in-the-loop.git"
    },
    "homepage": "https://github.com/markelayan/agents-in-the-loop#readme",
    "bugs": {
        "type": "git",
        "url": "https://github.com/markelayan/agents-in-the-loop/issues"
    },
    "keywords": [
        "dsh",
        "dsh-plugin",
        "deepseek-harness",
        "agents",
        "multi-agent",
        "session-messaging",
        "contacts",
        "call-center"
    ],
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "compatibility": {
            "dshReleases": {
                "0.1.2": "compatible",
                "0.1.6-alpha.1": "compatible",
                "0.1.7-rc.2": "compatible"
            }
        }
    },
    "engines": {
        "node": ">=20",
        "@deepseek-ai/dsh": ">=0.1.2"
    },
    "peerDependencies": {
        "@deepseek-ai/dsh": ">=0.1.2"
    },
    "peerDependenciesMeta": {
        "@deepseek-ai/dsh": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public"
    }
}
